# Supabase (bkz. https://app.supabase.com > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnizca sunucu tarafinda kullanilir; ASLA istemciye/loglara sizdirmayin.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth: Supabase Dashboard > Authentication > Providers > Google
# Client ID/Secret Google Cloud Console'dan alinir (bkz. docs/google-auth-setup.md).
# Google Workspace ozel domainler (ornek ben@yigitbaki.com) icin virgulle ayirin:
ALLOWED_EMAIL_DOMAINS=yigitbaki.com

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Chrome eklentisi <-> web app token bridge icin rastgele, uzun bir sir uretin:
# `openssl rand -base64 32`
EXTENSION_TOKEN_SIGNING_SECRET=

# Opsiyonel: rate limiting (bos birakilirsa limiter devre disi kalir)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opsiyonel: Sentry (Faz 7). Bos birakilirsa SDK sessizce devre disi kalir.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
