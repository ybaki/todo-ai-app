# Supabase (bkz. https://app.supabase.com > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnizca sunucu tarafinda kullanilir; ASLA istemciye/loglara sizdirmeyin.
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Entra App Registration (FAZ 0 PoC ciktisi; bkz. docs/entra-app-registration.md)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "organizations" (herhangi bir kurumsal hesap) veya belirli bir tenant GUID'i
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Ayrica Supabase Auth Dashboard > Authentication > Providers > Azure altina da
# ayni (veya ayri, YALNIZCA login icin) client id/secret girilmelidir.
# Bkz. https://supabase.com/docs/guides/auth/social-login/auth-azure

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Chrome eklentisi <-> web app token bridge icin rastgele, uzun bir sir uretin:
# `openssl rand -base64 32`
EXTENSION_TOKEN_SIGNING_SECRET=

# Opsiyonel: rate limiting (bos birakilirsa limiter devre disi kalir)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opsiyonel: Sentry (Faz 7). Bos birakilirsa SDK sessizce devre disi kalir.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Yalnizca CI/production build sirasinda source map yuklemek icin gerekli:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
