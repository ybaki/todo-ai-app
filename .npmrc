# @supabase/supabase-js bilincli olarak 2.55.0'a sabitlendi (bkz. README
# "Bilinen sorunlar" bolumu): daha yeni surumler, el yazimi Database
# tipleriyle strictNullChecks altinda insert/update/rpc cagrilarini
# yanlislikla `never` tipine dusuruyor. @supabase/ssr'nin declared peer
# dependency'si daha yeni bir surum istedigi icin peer conflict cikiyor;
# bu ayar npm install'in bu uyari yuzunden basarisiz olmasini engeller.
legacy-peer-deps=true
